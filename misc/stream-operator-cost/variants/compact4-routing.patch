+  private val monitor   = new Object
+  private val storage   = new Storage
+  private val fixedData = fixed.map(storage.lanes)
+  // Phase is the sole published terminal authority. Reader/cleanup components
+  // and Control views are accessed only under monitor. Publish phase last so
+  // outside admission checks never rely on a shadow lifecycle flag.
+  @volatile private var phase: Phase = Phase.Open
+  private var readOwnership: Reader  = Reader.Waiting
+  private var cleanupClaimed         = false
+  private def control: Control = {
+    val current = phase
+    if (current == Phase.Open && !cleanupClaimed) {
+      if (readOwnership == Reader.Waiting) idleControl else readingControl
+    } else Control(current, readOwnership, cleanupClaimed)
+  }
+  private def control_=(next: Control): Unit = {
+    readOwnership = next.reader
+    cleanupClaimed = next.cleanupClaimed
+    if (!(phase eq next.phase)) phase = next.phase
+  }
