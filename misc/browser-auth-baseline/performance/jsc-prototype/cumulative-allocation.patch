+JSC_DEFINE_HOST_FUNCTION(functionSpoonbillAllocationOracle, (JSGlobalObject* globalObject, CallFrame* callFrame))
+{
+    VM& vm = globalObject->vm();
+    JSLockHolder lock(vm);
+    unsigned count = callFrame->argument(0).asUInt32();
+    RELEASE_ASSERT(count && count <= 50000);
+    bool precise = callFrame->argumentCount() > 1 && callFrame->argument(1).asUInt32();
+    unsigned inlineCapacity = precise ? JSFinalObject::maxInlineCapacity : 0;
+    DeferGC deferGC(vm);
+    Structure* structure = JSFinalObject::createStructure(vm, globalObject, globalObject->objectPrototype(), inlineCapacity);
+    auto& space = vm.heap.objectSpace();
+    auto* sample = JSFinalObject::create(vm, structure);
+    RELEASE_ASSERT(!precise || sample->isPreciseAllocation());
+    uint64_t refusalBefore = space.spoonbillCellBytes();
+    space.spoonbillRefuseNextPreciseForTest();
+    RELEASE_ASSERT(!PreciseAllocation::tryCreate(vm.heap, 1024, sample->subspace(), 0));
+    RELEASE_ASSERT(space.spoonbillCellBytes() == refusalBefore);
+    uint64_t beforePrecise = space.spoonbillPreciseCellBytes();
+    uint64_t before = space.spoonbillCellBytes();
+    uint64_t expected = 0;
+    MarkedArgumentBuffer roots;
+    for (unsigned index = 0; index < count; ++index) {
+        auto* object = JSFinalObject::create(vm, structure);
+        expected += object->cellSize(); // Oracle reads allocated cell metadata, not ledger inputs.
+        roots.append(object);
+    }
+    RELEASE_ASSERT(!roots.hasOverflowed());
+    uint64_t after = space.spoonbillCellBytes();
+    RELEASE_ASSERT(space.spoonbillAllocationLedgerValid());
+    RELEASE_ASSERT(after >= before && after - before == expected);
+    RELEASE_ASSERT(space.spoonbillCellBytes() == after); // Quiescent reads must not double-charge.
+    if (precise)
+        RELEASE_ASSERT(space.spoonbillPreciseCellBytes() - beforePrecise == expected);
+    uint64_t overflow = std::numeric_limits<uint64_t>::max() - 4;
+    RELEASE_ASSERT(!MarkedSpace::spoonbillCheckedAdd(overflow, 5));
+    RELEASE_ASSERT(overflow == std::numeric_limits<uint64_t>::max() - 4);
+    RELEASE_ASSERT(MarkedSpace::spoonbillCheckedAdd(overflow, 4));
+    return JSValue::encode(jsNumber(static_cast<double>(expected)));
+}
