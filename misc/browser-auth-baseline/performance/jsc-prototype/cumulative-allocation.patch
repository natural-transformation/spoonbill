+bool MarkedSpace::spoonbillCheckedAdd(uint64_t& total, uint64_t bytes)
+{
+    if (bytes > std::numeric_limits<uint64_t>::max() - total)
+        return false;
+    total += bytes;
+    return true;
+}
+
+void MarkedSpace::spoonbillRecordCellAllocation(size_t bytes, bool precise)
+{
+    if (!m_spoonbillAllocationValid)
+        return;
+    if (!spoonbillCheckedAdd(m_spoonbillCellBytes, bytes)
+        || (precise && !spoonbillCheckedAdd(m_spoonbillPreciseBytes, bytes)))
+        m_spoonbillAllocationValid = false;
+}
+
+uint64_t MarkedSpace::spoonbillCellBytes()
+{
+    ASSERT(heap().vm().currentThreadIsHoldingAPILock());
+    heap().stopIfNecessary();
+    Locker locker { m_directoryLock };
+    forEachDirectory([](BlockDirectory& directory) {
+        directory.spoonbillFlushAllocatedCells();
+        return IterationStatus::Continue;
+    });
+    return m_spoonbillCellBytes;
+}
