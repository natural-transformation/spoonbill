+// Experimental interpreter-only cell ledger. Never adjust GC scheduling counters.
+void LocalAllocator::spoonbillFlushAllocatedCells()
+{
+    m_directory->assertIsMutatorOrMutatorIsStopped();
+    if (!isJSCellKind(m_directory->cellKind()))
+        return;
+    unsigned remaining = 0;
+    m_freeList.forEach([&](HeapCell*) { remaining += m_freeList.cellSize(); });
+    auto& space = m_directory->markedSpace();
+    if (remaining > m_freeList.originalSize()) {
+        space.spoonbillInvalidateAllocationLedger();
+        return;
+    }
+    unsigned consumed = m_freeList.originalSize() - remaining;
+    if (consumed < m_spoonbillChargedBytes) {
+        space.spoonbillInvalidateAllocationLedger();
+        return;
+    }
+    space.spoonbillRecordCellAllocation(consumed - m_spoonbillChargedBytes);
+    m_spoonbillChargedBytes = consumed;
+}
