+++ b/modules/spoonbill/src/main/scala/korolev/auth/BrowserCoordinatorGateMachine.scala
@@ -0,0 +1,191 @@
+package spoonbill.auth
+
+import scala.annotation.tailrec
+
+/**
+ * Bounded keyed read/write scheduling. Tickets identify interpreter-owned
+ * callbacks; clocks, callback order of execution and close results stay in the
+ * interpreter.
+ */
+private[auth] object BrowserCoordinatorGateMachine {
+  final class Ticket
+  enum Admission {
+    case Ordinary, Cleanup, Close
+    case Read(key: Any)
+  }
+  enum Turn {
+    case Write
+    case Read(key: Any)
+  }
+  enum Mode {
+    case Idle
+    case Writing(closeOwner: Boolean)
+    case Reading(keys: Set[Any])
+  }
+  enum Closure {
+    case Open
+    case Closing(waiters: List[Ticket])
+    case Closed
+  }
+  enum Entry {
+    case Writer(ticket: Ticket, closeOwner: Boolean)
+    case Reader(ticket: Ticket, key: Any, waited: Boolean)
+  }
+  final case class State(mode: Mode, pending: Vector[Entry], closure: Closure)
+  enum Decision { case Reject, ReplayClose, JoinClose, DirectWrite, DirectRead, Enqueue }
+  enum Command {
+    case Reject(ticket: Ticket)
+    case ReplayClose(ticket: Ticket)
+    case GrantWriter(ticket: Ticket)
+    case GrantReader(ticket: Ticket, waited: Boolean)
+    case CompleteClose(waiters: List[Ticket])
+  }
+
+  val initial: State                               = State(Mode.Idle, Vector.empty, Closure.Open)
+  private val writing: State                       = State(Mode.Writing(false), Vector.empty, Closure.Open)
+  private val closingWrite: State                  = State(Mode.Writing(true), Vector.empty, Closure.Closing(Nil))
+  private val idleResult: (State, Vector[Command]) = (initial, Vector.empty)
+
+  def isClosing(state: State): Boolean = state.closure != Closure.Open
+  private def keys(mode: Mode): Set[Any] = mode match {
+    case Mode.Reading(active) => active
+    case _                    => Set.empty
+  }
+  def runningReads(state: State): Int = keys(state.mode).size
+  def queuedReads(state: State): Int  = state.pending.count(_.isInstanceOf[Entry.Reader])
+  def queuedWrites(state: State): Int = state.pending.size - queuedReads(state)
+
+  def decision(state: State, kind: Admission, capacity: Int, readCapacity: Int): Decision = {
+    val rejectable = kind match {
+      case Admission.Ordinary | Admission.Read(_) => true
+      case _                                      => false
+    }
+    if (rejectable && (isClosing(state) || state.pending.size >= capacity)) Decision.Reject
+    else if (!rejectable && isClosing(state)) state.closure match {
+      case Closure.Closed => Decision.ReplayClose
+      case _              => Decision.JoinClose
+    }
+    else if (state.pending.nonEmpty) Decision.Enqueue
+    else
+      kind match {
+        case Admission.Read(key) =>
+          state.mode match {
+            case Mode.Writing(_)                                            => Decision.Enqueue
+            case mode if keys(mode).size < readCapacity && !keys(mode)(key) => Decision.DirectRead
+            case _                                                          => Decision.Enqueue
+          }
+        case _ => if (state.mode == Mode.Idle) Decision.DirectWrite else Decision.Enqueue
+      }
+  }
+
+  /**
+   * The interpreter's common uncontended path needs no ticket or command
+   * allocation.
+   */
+  def direct(state: State, kind: Admission): State = kind match {
+    case Admission.Read(key) => state.copy(mode = Mode.Reading(keys(state.mode) + key))
+    case Admission.Close     => closingWrite
+    case _                   => writing
+  }
+
+  private def normalized(mode: Mode, pending: Vector[Entry], closure: Closure): State =
+    if (pending.isEmpty && closure == Closure.Open) mode match {
+      case Mode.Idle           => initial
+      case Mode.Writing(false) => writing
+      case _                   => State(mode, pending, closure)
+    }
+    else State(mode, pending, closure)
+
+  private def dispatch(state: State, readCapacity: Int): (State, Vector[Command]) = {
+    def end(index: Int, mode: Mode, blocked: Vector[Entry], grants: Vector[Command]): (State, Vector[Command]) =
+      (normalized(mode, blocked ++ state.pending.drop(index), state.closure), grants)
+    @tailrec def scan(
+      index: Int,
+      mode: Mode,
+      blocked: Vector[Entry],
+      grants: Vector[Command]
+    ): (State, Vector[Command]) =
+      if (index == state.pending.size) end(index, mode, blocked, grants)
+      else
+        state.pending(index) match {
+          case Entry.Writer(ticket, closeOwner) =>
+            if (mode == Mode.Idle && blocked.isEmpty)
+              end(index + 1, Mode.Writing(closeOwner), blocked, grants :+ Command.GrantWriter(ticket))
+            else end(index, mode, blocked, grants)
+          case Entry.Reader(ticket, key, waited) =>
+            val active = keys(mode)
+            mode match {
+              case Mode.Writing(_)                  => end(index, mode, blocked, grants)
+              case _ if active.size >= readCapacity => end(index, mode, blocked, grants)
+              case _ if active(key)                 => scan(index + 1, mode, blocked :+ Entry.Reader(ticket, key, true), grants)
+              case _ =>
+                scan(index + 1, Mode.Reading(active + key), blocked, grants :+ Command.GrantReader(ticket, waited))
+            }
+        }
+    scan(0, state.mode, Vector.empty, Vector.empty)
+  }
+
+  def acquire(
+    state: State,
+    kind: Admission,
+    ticket: Ticket,
+    capacity: Int,
+    readCapacity: Int
+  ): (State, Vector[Command]) =
+    decision(state, kind, capacity, readCapacity) match {
+      case Decision.Reject      => (state, Vector(Command.Reject(ticket)))
+      case Decision.ReplayClose => (state, Vector(Command.ReplayClose(ticket)))
+      case Decision.JoinClose =>
+        state.closure match {
+          case Closure.Closing(waiters) => (state.copy(closure = Closure.Closing(ticket :: waiters)), Vector.empty)
+          case _                        => (state, Vector.empty)
+        }
+      case Decision.DirectWrite => (direct(state, kind), Vector(Command.GrantWriter(ticket)))
+      case Decision.DirectRead  => (direct(state, kind), Vector(Command.GrantReader(ticket, false)))
+      case Decision.Enqueue =>
+        val entry = kind match {
+          case Admission.Read(key) => Entry.Reader(ticket, key, false)
+          case _                   => Entry.Writer(ticket, kind == Admission.Close)
+        }
+        val closure = if (kind == Admission.Close) Closure.Closing(Nil) else state.closure
+        dispatch(state.copy(pending = state.pending :+ entry, closure = closure), readCapacity)
+    }
+
+  def finished(state: State, turn: Turn, closeOwner: Boolean, readCapacity: Int): (State, Vector[Command]) =
+    if (!closeOwner && state.pending.isEmpty && state.closure == Closure.Open) state.mode match {
+      case Mode.Writing(false) if turn == Turn.Write => idleResult
+      case Mode.Reading(active) if active.size == 1 =>
+        turn match {
+          case Turn.Read(key) if active(key) => idleResult
+          case _                             => finishQueued(state, turn, closeOwner, readCapacity)
+        }
+      case _ => finishQueued(state, turn, closeOwner, readCapacity)
+    }
+    else finishQueued(state, turn, closeOwner, readCapacity)
+
+  private def finishQueued(
+    state: State,
+    turn: Turn,
+    closeOwner: Boolean,
+    readCapacity: Int
+  ): (State, Vector[Command]) = {
+    val nextMode: Option[Mode] = (state.mode, turn) match {
+      case (Mode.Writing(owner), Turn.Write) if owner == closeOwner => Some(Mode.Idle)
+      case (Mode.Reading(active), Turn.Read(key)) if !closeOwner && active(key) =>
+        val remaining = active - key
+        Some(if (remaining.isEmpty) Mode.Idle else Mode.Reading(remaining))
+      case _ => None
+    }
+    nextMode match {
+      case None => (state, Vector.empty)
+      case Some(mode) =>
+        val (closure, completed) = if (closeOwner) state.closure match {
+          case Closure.Closing(waiters) => (Closure.Closed, Vector(Command.CompleteClose(waiters)))
+          case other                    => (other, Vector.empty)
+        }
+        else (state.closure, Vector.empty)
+        val (next, grants) = dispatch(state.copy(mode = mode, closure = closure), readCapacity)
+        (next, completed ++ grants)
+    }
+  }
+}
